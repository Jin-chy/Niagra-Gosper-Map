{
  "name": "niagara-services-map",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run check && npm run clean && tsc -p tsconfig.server.json && esbuild src/map.ts --bundle --minify --outdir=dist/public/assets --loader:.png=file",
    "build:static": "npm run build && node dist/server/scripts/build-static.js",
    "start": "node dist/server/app.js",
    "dev": "npm run build && npm start",
    "preview:static": "npm run build:static && wrangler pages dev dist/public",
    "deploy": "npm run build:static && wrangler pages deploy --branch main"
  },
  "dependencies": {
    "d3-dsv": "3.0.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/d3-dsv": "3.0.7",
    "@types/leaflet": "1.9.21",
    "@types/node": "22.20.0",
    "@types/qrcode": "1.5.6",
    "esbuild": "0.28.1",
    "leaflet": "1.9.4",
    "typescript": "5.9.3",
    "wrangler": "^4.164.0"
  }
}
